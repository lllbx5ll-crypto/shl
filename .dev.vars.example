# ZYQMORA AI — Cloudflare Pages local secrets template
# This file is safe to commit because the values are intentionally empty.
# For local development, copy this file to ".dev.vars" and fill the values there.
# NEVER paste real API keys into this tracked example file or commit ".dev.vars".
#
# Production: add these as encrypted Secrets in Cloudflare Pages:
# Workers & Pages > zyqmora-ai > Settings > Variables and Secrets.
# Add them to both Production and Preview environments.

# Required to activate the OpenRouter model pool
OPENROUTER_API_KEY=

# Optional providers for additional model diversity and fallback
GEMINI_API_KEY=
GROQ_API_KEY=
