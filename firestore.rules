rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Each customer can access only their own profile.
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow delete: if false;
    }

    match /projects/{projectId} {
      // A project is private and visible only to its owner.
      allow read, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'prompt', 'status', 'framework',
          'visibility', 'createdAt', 'updatedAt', 'generatedFiles', 'aiModel', 'publishedSiteId'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.prompt.size() <= 6000
        && request.resource.data.status == 'draft'
        && request.resource.data.framework == 'html'
        && request.resource.data.visibility == 'private'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('publishedSiteId' in request.resource.data)
            || (request.resource.data.publishedSiteId is string
              && request.resource.data.publishedSiteId == request.auth.uid + '_' + projectId))
        && (!('aiModel' in request.resource.data) || (request.resource.data.aiModel is string && request.resource.data.aiModel.size() <= 120))
        && (!('generatedFiles' in request.resource.data) || (
          request.resource.data.generatedFiles is map
          && request.resource.data.generatedFiles.keys().hasAll(['index.html', 'styles.css', 'script.js'])
          && request.resource.data.generatedFiles.keys().hasOnly(['index.html', 'styles.css', 'script.js'])
          && request.resource.data.generatedFiles['index.html'] is string
          && request.resource.data.generatedFiles['index.html'].size() <= 100000
          && request.resource.data.generatedFiles['styles.css'] is string
          && request.resource.data.generatedFiles['styles.css'].size() <= 100000
          && request.resource.data.generatedFiles['script.js'] is string
          && request.resource.data.generatedFiles['script.js'].size() <= 100000
        ));

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'prompt', 'status', 'framework',
          'visibility', 'createdAt', 'updatedAt', 'generatedFiles', 'aiModel', 'publishedSiteId'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() <= 6000
        && (!('publishedSiteId' in request.resource.data)
            || (request.resource.data.publishedSiteId is string
              && request.resource.data.publishedSiteId == request.auth.uid + '_' + projectId))
        && (!('aiModel' in request.resource.data) || (request.resource.data.aiModel is string && request.resource.data.aiModel.size() <= 120))
        && (!('generatedFiles' in request.resource.data) || (
          request.resource.data.generatedFiles is map
          && request.resource.data.generatedFiles.keys().hasAll(['index.html', 'styles.css', 'script.js'])
          && request.resource.data.generatedFiles.keys().hasOnly(['index.html', 'styles.css', 'script.js'])
          && request.resource.data.generatedFiles['index.html'] is string
          && request.resource.data.generatedFiles['index.html'].size() <= 100000
          && request.resource.data.generatedFiles['styles.css'] is string
          && request.resource.data.generatedFiles['styles.css'].size() <= 100000
          && request.resource.data.generatedFiles['script.js'] is string
          && request.resource.data.generatedFiles['script.js'].size() <= 100000
        ));
    }

    // Public website snapshots are readable ONLY when the owner publishes them.
    // Their ids are deterministically scoped to the Firebase UID and project id.
    match /publishedSites/{siteId} {
      function validWebsite(data) {
        return data.keys().hasOnly([
            'ownerUid', 'projectId', 'name', 'status', 'files', 'createdAt', 'updatedAt'
          ])
          && data.ownerUid is string
          && data.projectId is string
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 80
          && data.status == 'published'
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.files is map
          && data.files.keys().hasAll(['index.html', 'styles.css', 'script.js'])
          && data.files.keys().hasOnly(['index.html', 'styles.css', 'script.js'])
          && data.files['index.html'] is string
          && data.files['index.html'].size() > 0
          && data.files['index.html'].size() <= 100000
          && data.files['styles.css'] is string
          && data.files['styles.css'].size() <= 100000
          && data.files['script.js'] is string
          && data.files['script.js'].size() <= 100000;
      }

      function publishOwnProject(data) {
        return signedIn()
          && data.ownerUid == request.auth.uid
          && siteId == request.auth.uid + '_' + data.projectId
          && get(/databases/$(database)/documents/projects/$(data.projectId)).data.ownerUid == request.auth.uid;
      }

      allow get: if resource.data.status == 'published';
      allow list: if false;

      allow create: if validWebsite(request.resource.data)
        && publishOwnProject(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdAt == resource.data.createdAt
        && validWebsite(request.resource.data)
        && publishOwnProject(request.resource.data);

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
